# ═══════════════════════════════════════════════════════════
#  VIRA — Environment Variables
#  فایل: .env.local  (این فایل رو به .gitignore اضافه کن)
# ═══════════════════════════════════════════════════════════


# ─────────────────────────────────────────────
#  🌐 BASE URL سرور اصلی
#  تمام API های پروژه از این متغیر استفاده می‌کنن
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://viratest2.ir


# ─────────────────────────────────────────────
#  🔧 ماژول repairshops
#  فایل‌ها: Requestsapi.js / shopsApi.js / tmCodesApi.js
#           factors/* / finalstatements/* / requests/*
#           repairmen/* / shops/* / pmgroups/* / tmrequests/*
#           warehouse/* / useShops.js
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_REPAIRSHOPS=https://viratest2.ir/api/v1/repairshops

# زیرمجموعه‌های repairshops — هر کدوم رو جداگانه تنظیم کن
NEXT_PUBLIC_API_SHOPS=https://viratest2.ir/api/v1/repairshops/shops
NEXT_PUBLIC_API_TM_CODES=https://viratest2.ir/api/v1/repairshops/tmCodes
NEXT_PUBLIC_API_REPAIRMEN=https://viratest2.ir/api/v1/repairshops/repairmen
NEXT_PUBLIC_API_PM_GROUPS=https://viratest2.ir/api/v1/repairshops/pmGroups
NEXT_PUBLIC_API_TM_REQUESTS=https://viratest2.ir/api/v1/repairshops/tmRequests
NEXT_PUBLIC_API_FINAL_STATEMENTS=https://viratest2.ir/api/v1/repairshops/finalStatements
NEXT_PUBLIC_API_FINAL_STATEMENTS_FACTORS=https://viratest2.ir/api/v1/repairshops/finalStatementsFactors


# ─────────────────────────────────────────────
#  📦 ماژول warehouse
#  فایل‌ها: warehouse/products/* / customers/* / storehouses/*
#           warehouse/factors / requests / transfers
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_WAREHOUSE=https://viratest2.ir/api/v1/warehouse

# زیرمجموعه‌های warehouse
NEXT_PUBLIC_API_WAREHOUSE_PRODUCTS=https://viratest2.ir/api/v1/warehouse/products
NEXT_PUBLIC_API_WAREHOUSE_CUSTOMERS=https://viratest2.ir/api/v1/warehouse/customers
NEXT_PUBLIC_API_WAREHOUSE_STOREHOUSES=https://viratest2.ir/api/v1/warehouse/storehouses
NEXT_PUBLIC_API_WAREHOUSE_FACTORS=https://viratest2.ir/api/v1/warehouse/factors
NEXT_PUBLIC_API_WAREHOUSE_REQUESTS=https://viratest2.ir/api/v1/warehouse/requests
NEXT_PUBLIC_API_WAREHOUSE_TRANSFERS=https://viratest2.ir/api/v1/warehouse/transfer_between_storehouses
NEXT_PUBLIC_API_WAREHOUSE_UNITS=https://viratest2.ir/api/v1/warehouse/units


# ─────────────────────────────────────────────
#  🚚 ماژول waybills (بارنامه)
#  فایل‌ها: waybillRegistry.js / Usewaybillform.js
#           waybills/create/* / waybills/edit/* / waybills/show/*
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_WAYBILLS=https://viratest2.ir/api/v1/waybills


# ─────────────────────────────────────────────
#  🔍 ماژول search (Live Search)
#  فایل: utils/Waybillapi.js
#  این‌ها internal Next.js route هستن — فقط اگه route ها رو
#  به سرور خارجی وصل کردی تغییر بده
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_SEARCH_BASE=/api/search


# ─────────────────────────────────────────────
#  ⚙️ تنظیمات عمومی اپ
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=سامانه ویرا
NEXT_PUBLIC_APP_VERSION=1.0.0

# آدرس فرانت (برای redirect های سرور)
NEXT_PUBLIC_APP_URL=http://localhost:3000
